STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_PRICE_THALIA_NORMAL=price_1UFdPgKF5SzJ8HUuG6O1Ll7Q

# Integración con Google Calendar (#96). El cliente OAuth es distinto del que
# usa Supabase para el login: este necesita acceso sin caducidad para que el
# worker pueda sincronizar de madrugada.
THALIA_GOOGLE_CALENDAR_OAUTH_ID=replace_me.apps.googleusercontent.com
THALIA_GOOGLE_CALENDAR_OAUTH_SECRET=GOCSPX-replace_me
# Secreto compartido con pg_cron para llamar a /api/google-calendar/sync.
# El mismo valor tiene que estar en Vault: select vault.create_secret('...', 'calendar_sync_secret');
THALIA_CALENDAR_SYNC_SECRET=replace_me
