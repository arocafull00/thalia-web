{
  "name": "thalia-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node src/tests/e2e/run-with-local-supabase.mjs",
    "test:e2e:ci": "node src/tests/e2e/run-with-local-supabase.mjs --reporter=github,html",
    "test:e2e:report": "playwright show-report",
    "db:reset-and-seed:production": "node --env-file=.env scripts/reset-and-seed-production.mjs",
    "video:preview": "pnpm --dir videos/thalia-product-promo dev",
    "video:render": "pnpm --dir videos/thalia-product-promo render",
    "validate:push": "pnpm typecheck && pnpm test:run",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "dev:https": "next dev --experimental-https"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.6.0",
    "@pdfslick/react": "^4.0.0",
    "@preact/signals": "^2.9.2",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/themes": "^3.3.0",
    "@schedule-x/calendar": "^4.6.0",
    "@schedule-x/calendar-controls": "^4.6.0",
    "@schedule-x/events-service": "^4.6.0",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-default": "^4.6.0",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-table": "^8.21.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cuelume": "^0.1.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.21.0",
    "match-sorter": "^8.3.0",
    "next": "16.2.9",
    "preact": "^10.29.3",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-compare-slider": "^4.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-dropzone": "^16.0.0",
    "react-hook-form": "^7.80.0",
    "react-toastify": "^11.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "temporal-polyfill": "^1.0.1",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.32.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.6.2",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
